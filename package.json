{
  "name": "saucedemo-ui-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript UI automation for SauceDemo",
  "scripts": {
    "test": "playwright test -c src/config/playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "report": "playwright show-report playwright-report",
    "allure:report": "allure generate allure-results --clean -o allure-report --open",
    "clean:reports": "rm -rf test-results playwright-report allure-results allure-report",
    "install:browsers": "playwright install chromium firefox"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "allure": "3.33.0",
    "allure-playwright": "3.15.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.12.2",
    "eslint-plugin-prettier": "5.5.7",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
